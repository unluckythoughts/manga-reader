# Service Configuration
SERVICE_NAME=book-reader
SERVICE_ENABLE_DB=true
SERVICE_DB_TYPE=sqlite
SERVICE_ENABLE_CACHE=false
SERVICE_ENABLE_BUS=false

# Database Configuration - SQLite (if using sqlite)
DB_FILE_PATH=./data/book_reader.db
# DB_DEBUG=false

# Web Server Configuration
WEB_PORT=8080
WEB_SOCKET_PATH=/socket
WEB_WORKER_COUNT=20
WEB_CORS=true
WEB_PROXY=false

# Logger Configuration
LOG_LEVEL=debug

# Session Configuration
# Set a consistent session secret key to prevent cookie invalidation on server restart
# Generate a new one with: openssl rand -base64 32
SESSION_SECRET_KEY=your-secret-key-change-this-in-production
